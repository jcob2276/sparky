{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<WSTAW_SWOJ_TOKEN_TUTAJ>"
      }
    },
    "claude-context": {
      "command": "npx",
      "args": ["-y", "claude-context-mcp"],
      "env": {}
    },
    "appllama": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.appllama.io/mcp"
      ]
    }
  }
}
