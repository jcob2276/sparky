{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "supabase/functions/*/index.ts",
    "scripts/**/*.{mjs,ts,cjs}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "supabase/functions/**/*.ts"
  ],
  "ignore": [
    "src/sw.ts",
    "src/lib/database.types.ts",
    "supabase/functions/_shared/database.types.ts"
  ],
  "ignoreIssues": {},
  "ignoreDependencies": [
    "npm",
    "playwright",
    "@playwright/test"
  ]
}
